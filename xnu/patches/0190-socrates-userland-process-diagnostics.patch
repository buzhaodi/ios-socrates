From: socrates bring-up
Subject: [PATCH] socrates: enable process sampling independently of old peripherals

Boot18 completes launchd early boot but delivers no UI frames. Retain the
SM8250 hardware exclusion while allowing the existing pure process sampler.
Report the watched names and match count, and allow bounded sample timing
so a diagnostic boot can show whether UI services exist without a root flash.

--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1113,6 +1113,8 @@
 	 * available without touching unported clocks/input/USB/RPMh hardware.
 	 * Bring up the SM8550 peripherals individually in later milestones. */
 	if (ufs_is_socrates()) {
+		/* Pure process diagnostics; no legacy peripheral MMIO. */
+		sweet_sample_start();
 		printf("SWEET UFS: socrates root ready; unported SM8250 peripherals skipped\n");
 		return 0;
 	}
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -11,6 +11,7 @@
  * syscall stub in pc and its caller in lr/bt.
  *
  * First sample 90 s after start, then every 120 s, 40 samples at most.
+ * sweetsample_delay / sweetsample_interval override seconds (1..3600).
  */
 #include <sys/param.h>
 #include <sys/systm.h>
@@ -47,11 +48,12 @@
 extern void sweet_sample_task(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
 
 static int
-sweet_sample_proc(proc_t p, __unused void *arg)
+sweet_sample_proc(proc_t p, void *arg)
 {
 	char name[32];
 	proc_name(proc_pid(p), name, sizeof(name));
 	if (sweet_sample_wanted(name)) {
+		(*(unsigned int *)arg)++;
 		task_t task = proc_task(p);
 		if (task != TASK_NULL) {
 			sweet_sample_task(name, proc_pid(p), task);
@@ -64,17 +66,29 @@
 sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	static int chan;
+	int delay = 90, interval = 120;
 	if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
 		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
 	}
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	PE_parse_boot_argn("sweetsample_delay", &delay, sizeof(delay));
+	PE_parse_boot_argn("sweetsample_interval", &interval, sizeof(interval));
+	if (delay < 1 || delay > 3600) {
+		delay = 90;
+	}
+	if (interval < 1 || interval > 3600) {
+		interval = 120;
+	}
+	printf("SMP watching %s; delay %d s interval %d s\n", sweet_sample_names, delay, interval);
+	(void)tsleep(&chan, PZERO, "sweetsmp", delay * hz);
 	for (int i = 0; i < 40; i++) {
+		unsigned int matched = 0;
 		printf("SMP --- sample %d\n", i);
-		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, &matched, NULL, NULL);
+		printf("SMP --- matched %u processes\n", matched);
+		(void)tsleep(&chan, PZERO, "sweetsmp", interval * hz);
 	}
 }
 

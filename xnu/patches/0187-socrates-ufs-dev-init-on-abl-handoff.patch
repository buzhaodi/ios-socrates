+/* NOP OUT (UPIU type 0x00): the UFS-native link ping; the device answers
+ * NOP IN (0x20). The shim's M2 recipe proved the pipeline with it before
+ * any SCSI. */
+static int
+ufs_nop_out(void)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = 0x00;                     /* NOP OUT */
+	ucd->cmd[3] = ++su.tag;
+	utrd->dw0 = (1u << 28) | (1u << 24);    /* UFS storage, no data */
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	return ucd->resp[0] == 0x20 ? 0 : EIO;  /* NOP IN */
+}
+
+/* REPORT LUNS (SPC-5, opcode 0xa0): the M2 v6 lesson - the 04/02 sense on a
+ * freshly-cleared device is LUN-level; the host must enumerate the LUNs
+ * before the LU accepts I/O. */
+static int
+ufs_report_luns(uint32_t *luns_out)
+{
+	uint8_t *b = (uint8_t *)(su.dma + DMA_BOUNCE);
+	uint8_t cdb[12] = { 0xa0, 0, 0, 0, 0, 0, 0, 0, 16, 0, 0, 0 };
+	int error = ufs_scsi(cdb, sizeof(cdb), 16, false);
+	if (error) {
+		return error;
+	}
+	*luns_out = b[3] / 8;
+	return 0;
+}
+
+/* READ_ATTR dump for idn 0x00 (bBootLUNEn) and 0x01 (bCurrentPowerMode):
+ * flash #12's writes drew GENERIC_FAILURE; the READS say what the device
+ * actually reports (already-set? config-locked? power mode?). */
+static void
+ufs_dump_attrs(void)
+{
+	for (uint8_t idn = 0x00; idn <= 0x01; idn++) {
+		uint32_t rc = ufs_query(0x03, idn, 0x01);   /* READ_ATTR */
+		if (rc) {
+			printf("SWEET UFS: attr idn 0x%02x rc %d\n", idn, rc);
+			continue;
+		}
+		struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+		printf("SWEET UFS: attr idn 0x%02x = 0x%x\n", idn,
+		    (ucd->resp[19] << 8) | ucd->resp[20]);
+	}
+}
+
+/* Controller-state dump for the failure path: HCS, IS, the UIC command
+ * register, its ARG2, and the UIC error-code registers (0x44 UECDL data
+ * link, 0x48 UECPA PHY adapter) - to tell 'command never executed' from
+ * 'completed with error' from 'link negotiation failed'. */
+static void
+ufs_dump_ctl(const char *why)
+{
+	printf("SWEET UFS: ctl %s: hce 0x%x hcs 0x%x is 0x%x ucmd 0x%x arg2 0x%x "
+	    "uecdl 0x%x uecpa 0x%x\n", why,
+	    ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(REG_IS), ufs_rd(REG_UIC_CMD),
+	    ufs_rd(0x98), ufs_rd(0x44), ufs_rd(0x48));
+}
+

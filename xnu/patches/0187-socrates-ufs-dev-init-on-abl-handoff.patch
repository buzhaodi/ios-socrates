+	if (error) {
+		/* socrates flash #10 (2026-11-07): the sense on the CHECK CONDITION is
+		 * key 2 / ASC-ASCQ 04-02 - 'LOGICAL UNIT NOT READY, INITIALIZING COMMAND
+		 * REQUIRED'. The initializing command, panel-proven in the shim's M2 v18:
+		 * START STOP UNIT with POWER_CONDITION = ACTIVE (byte 4 = 0x11; the plain
+		 * START_VALID form draws 05/24 INVALID FIELD IN CDB). Then TUR once more. */
+		static const uint8_t ssu[6] = { 0x1b, 0, 0, 0, 0x11, 0 };
+		error = ufs_scsi(ssu, sizeof(ssu), 0, false);
+		printf("SWEET UFS: SSU ACTIVE rc %d\n", error);
+		if (!error) {
+			static const uint8_t tur3[6] = { 0x00 };
+			for (int i = 0; i < 3 && (error = ufs_scsi(tur3, sizeof(tur3), 0, false)); i++) {
